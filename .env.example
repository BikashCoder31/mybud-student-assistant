DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
MYBUD_MODE=demo
# Live mode requires both values and sends submitted inputs to Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=
# Production only: configure HTTPS origin and trust only your actual proxy.
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY=false
# Hosted deployments use a PostgreSQL URL. Local development keeps SQLite when blank.
DATABASE_URL=
# Vercel uses 3 MB so base64 JSON stays below the platform request limit.
MYBUD_MAX_IMAGE_MB=5
